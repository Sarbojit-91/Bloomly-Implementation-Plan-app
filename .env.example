# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The "service_role" / "secret" key. SERVER ONLY — used solely to delete accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Where the app runs; used to build email confirmation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
